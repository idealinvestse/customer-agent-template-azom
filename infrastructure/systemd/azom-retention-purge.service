[Unit]
Description=Azom Ops Agent — GDPR retention purge (delete/redact closed cases)
After=azom-backup.service

[Service]
Type=oneshot
User=azom
Group=azom
WorkingDirectory=/opt/azom-agent
Environment=PYTHONPATH=/opt/azom-agent/skills
Environment=AZOM_CONFIG_DIR=/opt/azom-agent/config
Environment=AZOM_DATA_DIR=/var/lib/azom
Environment=AZOM_USE_MOCK=0
EnvironmentFile=-/opt/azom-agent/.env
ExecStart=/opt/azom-agent/.venv/bin/python -m ecom_ops --actor oscar cases retention-purge --days 90
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/azom /var/log/azom /opt/azom-agent/.azom-data
