# WooCommerce
WOO_BASE_URL=https://azom.se
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Optional per-domain overrides
# WOO_BASE_URL_SE=
# WOO_BASE_URL_NO=
# WOO_BASE_URL_DK=
# WOO_BASE_URL_FI=

# WordPress REST API (Application Passwords, WP 5.6+)
# Create via: https://azom.no/wp-admin/authorize-application.php
WP_USERNAME=
WP_APP_PASSWORD=
# Per-site operations credentials (Phase 1). One variable per site in the
# selected registry (runtime override or config/wp_sites.yaml). These do not
# replace the shared content-client pair above; values never go in YAML.
# WP_SECRET_AZOM_NO=
# WP_SECRET_MOCK_SHOP=
# WP_SECRET_MOCK_STAGING=
# Optional: separate WP base URL (defaults to WOO_BASE_URL / convention)
# WP_BASE_URL=https://azom.no

# WooCommerce webhooks (optional — receiver endpoint)
# WOO_WEBHOOK_SECRET=

# SSH
# WordPress SFTP settings are per-site. The transport uses only the stored
# AZOM_DATA_DIR/ssh-keys/<site_id> key and the pinned site host key; it does not
# use SSH_PASSWORD, SSH_IDENTITY_FILE, SSH agent keys, or the SSH config file.
# The separate VPS read-only runner is disabled unless AZOM_SSH_READ_ENABLED=1.
# Enable it only for a dedicated non-root *-ssh-reader account with no sudo or
# docker group, server-side command restrictions, a pinned known_hosts file,
# and a unique OpenSSH private key. It accepts exact read-only health commands only.
# SSH_HOST, SSH_USER, SSH_PORT, SSH_IDENTITY_FILE, and SSH_KNOWN_HOSTS below
# belong to that runner and are not fallbacks for WordPress file access.
# The private key is stored under AZOM_DATA_DIR/ssh-keys and is not an
# environment variable. A normal backup excludes that directory.
# Neither SSH transport uses password authentication. Live file SSH also needs
# a pinned public host key. The form cannot set AZOM_WP_FILES_SSH.
# AZOM_SSH_READ_ENABLED=1
# SSH_HOST=135.181.45.193
# SSH_USER=azom-ssh-reader
# SSH_PORT=22
# SSH_IDENTITY_FILE=/path/to/key
# SSH_KNOWN_HOSTS=/path/to/pinned_known_hosts

# Model router (optional). Template text remains the fallback when no route works.
# Default order: chatgpt_oauth,xai_grok_build,xai_api_key,openrouter
# Unconfigured routes are skipped. A grok binary on PATH does not enable Grok Build.
# Until a live ChatGPT test without fallback succeeds, prefer:
# AZOM_MODEL_ROUTE_ORDER=xai_grok_build,xai_api_key,openrouter
# AZOM_MODEL_ROUTE_ORDER=
#
# ChatGPT Sign in with ChatGPT. Azom stores and rotates the refresh token under
# AZOM_DATA_DIR/model_oauth/ (mode 0600). Do not reuse Gmail, Google Marketing,
# or Codex client credentials. First registration uses client id
# dynamic_agent_client; the issued client id is saved in the session file.
# Leave all five unset to use the documented defaults: dynamic_agent_client,
# https://auth.openai.com/api/accounts/authorize, the matching token URL,
# http://127.0.0.1:$DASHBOARD_PORT/oauth/openai/callback, and a host id file
# under AZOM_DATA_DIR. If any one is set, the missing ones are not filled in.
# OPENAI_SIWC_AUTHORIZATION_URL=https://auth.openai.com/api/accounts/authorize
# OPENAI_SIWC_TOKEN_URL=https://auth.openai.com/api/accounts/oauth/token
OPENAI_SIWC_CLIENT_ID=
OPENAI_SIWC_REDIRECT_URI=
OPENAI_SIWC_AUTHORIZATION_URL=
OPENAI_SIWC_TOKEN_URL=
OPENAI_SIWC_HOST_ID=
# OPENAI_SIWC_SCOPE=openid profile email offline_access resource.invoke chatgpt.tokens.use.direct
# OPENAI_SIWC_RESOURCE=https://api.openai.com/v1
# OPENAI_SIWC_AGENT_NAME=Azom
OPENAI_MODEL=
#
# xAI Grok Build: delegated refresh. Azom does not read or rotate Grok Build auth.
# Set AZOM_XAI_GROK_BUILD=1 or an explicit XAI_GROK_BIN. Binary default is grok.
# AZOM_XAI_GROK_BUILD=
XAI_GROK_BIN=
XAI_MODEL=
# Idle timeout resets while Grok is streaming reasoning or text. Hard stop in seconds.
# AZOM_XAI_GROK_HARD_TIMEOUT=180
# Optional. Telegram free text calls this route only. Example: xai_grok_build
# AZOM_TELEGRAM_MODEL_ROUTE=
# xAI API key fallback. Separate from Grok Build.
XAI_API_KEY=
# OpenRouter fallback. Not required for the other routes.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# ---------------------------------------------------------------------------
# Mail connector
# MAIL_PROVIDER: gmail | outlook | exchange_graph | generic_imap | generic_pop3
#
# Provider matrix (set MAIL_PROVIDER + the vars for that row):
#   generic_imap / generic_pop3
#     → MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM
#     → SMTP_* + IMAP_* (or POP3_* for pop3)
#   gmail
#     → app password (MAIL_PASSWORD) OR OAuth (MAIL_OAUTH_* / dashboard Gmail consent)
#     → SMTP/IMAP defaults apply when hosts unset
#   outlook (IMAP+SMTP XOAUTH2 or app password)
#     → MAIL_USERNAME, MAIL_FROM + MAIL_PASSWORD *or* MAIL_OAUTH_*
#     → SMTP_HOST/IMAP_HOST for Outlook if not using provider defaults
#     → No dashboard Outlook OAuth UI yet (env + probe only)
#   exchange_graph
#     → GRAPH_TENANT_ID, GRAPH_CLIENT_ID, GRAPH_CLIENT_SECRET, GRAPH_USER
#     → optional GRAPH_BASE_URL (default https://graph.microsoft.com/v1.0)
# Oscar secrets probe: AZOM_USE_MOCK=0 runs a live fetch(limit=1); mock skips network.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=generic_imap
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=support@azom.se

# Per-mailbox credential prefix (config/mailboxes.yaml env_prefix, e.g. MAIL_SE_)
# Credential fields prefer {prefix}USERNAME / {prefix}PASSWORD / {prefix}FROM /
# {prefix}OAUTH_* and fall back to unprefixed MAIL_* only when prefix-specific
# vars are absent. Host/port/TLS fields prefer {prefix}SMTP_HOST etc. and fall
# back to unprefixed SMTP_* / IMAP_* / POP3_* / provider defaults.
# MAIL_SE_USERNAME=
# MAIL_SE_PASSWORD=
# MAIL_SE_FROM=support@azom.se

# SMTP (generic / Gmail / Outlook app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_PASSWORD=

# IMAP
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=true

# POP3
POP3_HOST=
POP3_PORT=995
POP3_USE_SSL=true

# OAuth2 (Gmail / Outlook IMAP+SMTP XOAUTH2)
# Use either app password (MAIL_PASSWORD) OR OAuth2 tokens below.
MAIL_OAUTH_ACCESS_TOKEN=
MAIL_OAUTH_REFRESH_TOKEN=
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=
MAIL_OAUTH_TOKEN_URL=
# Public callback URL (prod: https://dashboard.azom.no/oauth/gmail/callback)
MAIL_OAUTH_REDIRECT_URI=

# Microsoft Graph / Exchange Online (MAIL_PROVIDER=exchange_graph)
# Required for Graph provider (see matrix above). Not used for outlook IMAP.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_USER=
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Telegram dedicated bot (V2)
# AZOM_TELEGRAM_WORKERS=2  # Telegram background workers; allowed range 1..4
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to use the bot (required when AZOM_USE_MOCK=0)
# TELEGRAM_ALLOWED_CHAT_IDS=111111111,222222222
# Map chat_id → actor (jonatan|oscar|agent). Required when AZOM_USE_MOCK=0.
# TELEGRAM_ACTOR_MAP=111111111:jonatan,222222222:oscar
# TELEGRAM_FAIL_CLOSED=1
# Metrics scrape — required Bearer token. Empty token = /metrics always 403.
# Scrape 127.0.0.1:8080 directly (nginx denies /metrics).
# METRICS_SCRAPE_TOKEN=

# Meta Messenger (daily driver) — webhook via dashboard /webhooks/messenger
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
# Required in prod (AZOM_USE_MOCK=0): empty allowlist/actor-map = fail-closed
# MESSENGER_ALLOWED_PSIDS=psid1,psid2
# MESSENGER_ACTOR_MAP=psid1:jonatan,psid2:oscar
# Optional explicit flag (also implied when AZOM_USE_MOCK=0):
# MESSENGER_FAIL_CLOSED=1
# Public HTTPS dashboard URL for deep links (no trailing slash)
# AZOM_DASHBOARD_PUBLIC_URL=https://dashboard.azom.no

# Opt-in live integration smoke (Woo/mail/Telegram). Safe with AZOM_USE_MOCK=1.
# AZOM_LIVE_SMOKE=1
# Poll freshness for /health readiness (seconds; default 900)
# AZOM_POLL_STALE_SEC=900
# Cases Path B: force auto-send off even if config/cases_ai.yaml enables it
# AZOM_AUTO_SEND_KILL=1
# Null-send / Shadow Live Ledger (default off). When 1: refuse customer mail;
# poll records FU9 shadow decisions. Soft-soak: bin/mock-soak-azom.sh.
# Live soft-soak: Oscar sets AZOM_NULL_SEND=1 in .env + restarts poll/dashboard.
# See docs/CASES.md and docs/PILOT_OPS.md. Do NOT default-on in systemd.
# AZOM_NULL_SEND=0

# ---------------------------------------------------------------------------
# Google Ads + GA4 (see docs/MARKETING_GOOGLE.md)
# Fail-closed in live: empty property/customer allowlists deny.
# Mutate kill-switches (default deny when set):
# AZOM_ADS_MUTATE_KILL=1
# AZOM_GA_MUTATE_KILL=1
# AZOM_MP_KILL=1
# ---------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://dashboard.azom.no/oauth/google/callback
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# AZOM_GA4_PROPERTY_IDS=123456789
# AZOM_GADS_CUSTOMER_IDS=1234567890
# GA4_MEASUREMENT_ID=G-XXXX
# GA4_MEASUREMENT_API_SECRET=

# ---------------------------------------------------------------------------
# Web Search & Research (fail-closed; see config/research.yaml)
# Live egress requires AZOM_USE_MOCK=0 plus the explicit enable flags below
# set in the process environment (protected from dashboard overlays).
# ---------------------------------------------------------------------------
AZOM_WEB_SEARCH_ENABLED=0
AZOM_WEB_FETCH_ENABLED=0
AZOM_RESEARCH_ENABLED=0
# Kill-switches (set 1 to force off even when enabled above)
# AZOM_WEB_SEARCH_KILL=1
# AZOM_RESEARCH_KILL=1
AZOM_SEARCH_ROUTE_ORDER=parallel,exa,brave,tavily,searxng
AZOM_RESEARCH_DEFAULT_COUNTRY=SE
AZOM_RESEARCH_DEFAULT_LANG=sv
# Optional domain allowlist (comma-separated; narrows config/research.yaml)
# AZOM_SEARCH_ALLOWED_DOMAINS=
PARALLEL_API_KEY=
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Opt-in self-hosted SearXNG (HTTPS or local loopback only; never DASHBOARD_PORT)
# SEARXNG_BASE_URL=
# SEARXNG_API_KEY=

# ---------------------------------------------------------------------------
# Webshop Intelligence / Shop Intel (fail-closed; see docs/SHOP_INTEL.md)
# Live store learning requires AZOM_USE_MOCK=0 plus AZOM_SHOP_INTEL_LIVE_ENABLED=1
# in the process environment (AZOM_SHOP_INTEL_LIVE_ENABLED and AZOM_SHOP_INTEL_KILL
# are protected from dashboard runtime.env/secrets.env overlays).
# ---------------------------------------------------------------------------
AZOM_SHOP_INTEL_LIVE_ENABLED=0
AZOM_SHOP_INTEL_KILL=0
# Set 0 to disable tailored SHOP_INTEL_CONTEXT prompt injection (keeps stored dossiers):
AZOM_SHOP_INTEL_INJECT=1

# Dashboard auth (Jonatan viewer / Oscar full_admin)
DASHBOARD_USER=jonatan
DASHBOARD_PASSWORD=
# Prefer salted Werkzeug hash (pbkdf2:/scrypt:) — legacy SHA-256 hex still accepted:
# DASHBOARD_PASSWORD_HASH=
# Oscar Basic Auth (username: oscar)
DASHBOARD_OSCAR_PASSWORD=
# DASHBOARD_OSCAR_PASSWORD_HASH=
# Session/CSRF secret (required for POST forms in browser)
# DASHBOARD_SECRET_KEY=
# Secure session cookie. Unset: on in live mode, off in mock.
# Set 0 only for a local HTTP dashboard (127.0.0.1). Leave unset behind HTTPS.
# DASHBOARD_COOKIE_SECURE=

# Runtime
# Local/dev mock: AZOM_USE_MOCK=1
# Production (Ubuntu 24 / Hetzner): AZOM_USE_MOCK=0
# Mock default passwords (jonatan/oscar) ONLY work when AZOM_USE_MOCK=1
AZOM_USE_MOCK=1
# Typed WordPress file SSH. Default off. Ignored while AZOM_USE_MOCK=1.
# Set only in the process environment. Dashboard overlays and the SSH
# settings form cannot apply it. Hosts ending in .example.test are refused
# before any connection.
# AZOM_WP_FILES_SSH=0
# Review sandbox. Default off. Process environment only. Dashboard overlays
# cannot apply it. A value of 1 still refuses to start wp-env on this host
# until versions are known and a separate worker is chosen.
# AZOM_WP_SANDBOX=0
AZOM_CONFIG_DIR=./config
AZOM_DATA_DIR=./.azom-data
# Production paths (set by bootstrap-ubuntu24.sh):
# AZOM_CONFIG_DIR=/opt/azom-agent/config
# AZOM_DATA_DIR=/var/lib/azom

# Dashboard bind (systemd uses 127.0.0.1; Docker may use 0.0.0.0)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Waitress worker threads (default 12, allowed 4..32)
# DASHBOARD_THREADS=12
# Reverse proxy hop count (set 1 behind Caddy/Nginx, 0 when direct)
# TRUSTED_PROXY_COUNT=1
