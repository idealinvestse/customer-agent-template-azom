# WooCommerce
WOO_BASE_URL=https://azom.se
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Optional per-domain overrides
# WOO_BASE_URL_SE=
# WOO_BASE_URL_NO=
# WOO_BASE_URL_DK=
# WOO_BASE_URL_FI=

# WordPress REST API (Application Passwords, WP 5.6+)
# Create via: https://azom.no/wp-admin/authorize-application.php
WP_USERNAME=
WP_APP_PASSWORD=
# Optional: separate WP base URL (defaults to WOO_BASE_URL / convention)
# WP_BASE_URL=https://azom.no

# WooCommerce webhooks (optional — receiver endpoint)
# WOO_WEBHOOK_SECRET=

# SSH
SSH_HOST=azom-vps
SSH_USER=root
SSH_PORT=22
# SSH_IDENTITY_FILE=/path/to/key

# LLM (optional in V1; template generator is default)
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Mail connector
# MAIL_PROVIDER: gmail | outlook | exchange_graph | generic_imap | generic_pop3
#
# Provider matrix (set MAIL_PROVIDER + the vars for that row):
#   generic_imap / generic_pop3
#     → MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM
#     → SMTP_* + IMAP_* (or POP3_* for pop3)
#   gmail
#     → app password (MAIL_PASSWORD) OR OAuth (MAIL_OAUTH_* / dashboard Gmail consent)
#     → SMTP/IMAP defaults apply when hosts unset
#   outlook (IMAP+SMTP XOAUTH2 or app password)
#     → MAIL_USERNAME, MAIL_FROM + MAIL_PASSWORD *or* MAIL_OAUTH_*
#     → SMTP_HOST/IMAP_HOST for Outlook if not using provider defaults
#     → No dashboard Outlook OAuth UI yet (env + probe only)
#   exchange_graph
#     → GRAPH_TENANT_ID, GRAPH_CLIENT_ID, GRAPH_CLIENT_SECRET, GRAPH_USER
#     → optional GRAPH_BASE_URL (default https://graph.microsoft.com/v1.0)
# Oscar secrets probe: AZOM_USE_MOCK=0 runs a live fetch(limit=1); mock skips network.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=generic_imap
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=support@azom.se

# Per-mailbox credential prefix (config/mailboxes.yaml env_prefix, e.g. MAIL_SE_)
# Credential fields prefer {prefix}USERNAME / {prefix}PASSWORD / {prefix}FROM /
# {prefix}OAUTH_* and fall back to unprefixed MAIL_* only when prefix-specific
# vars are absent. Host/port/TLS fields prefer {prefix}SMTP_HOST etc. and fall
# back to unprefixed SMTP_* / IMAP_* / POP3_* / provider defaults.
# MAIL_SE_USERNAME=
# MAIL_SE_PASSWORD=
# MAIL_SE_FROM=support@azom.se

# SMTP (generic / Gmail / Outlook app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_PASSWORD=

# IMAP
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=true

# POP3
POP3_HOST=
POP3_PORT=995
POP3_USE_SSL=true

# OAuth2 (Gmail / Outlook IMAP+SMTP XOAUTH2)
# Use either app password (MAIL_PASSWORD) OR OAuth2 tokens below.
MAIL_OAUTH_ACCESS_TOKEN=
MAIL_OAUTH_REFRESH_TOKEN=
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=
MAIL_OAUTH_TOKEN_URL=
# Public callback URL (prod: https://your-domain/oauth/gmail/callback)
MAIL_OAUTH_REDIRECT_URI=

# Microsoft Graph / Exchange Online (MAIL_PROVIDER=exchange_graph)
# Required for Graph provider (see matrix above). Not used for outlook IMAP.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_USER=
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Telegram dedicated bot (V2)
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to use the bot (required when AZOM_USE_MOCK=0)
# TELEGRAM_ALLOWED_CHAT_IDS=111111111,222222222
# Map chat_id → actor (jonatan|oscar|agent). Required when AZOM_USE_MOCK=0.
# TELEGRAM_ACTOR_MAP=111111111:jonatan,222222222:oscar
# TELEGRAM_FAIL_CLOSED=1
# Metrics scrape (optional; localhost always allowed):
# METRICS_SCRAPE_TOKEN=

# Meta Messenger (daily driver) — webhook via dashboard /webhooks/messenger
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
# Required in prod (AZOM_USE_MOCK=0): empty allowlist/actor-map = fail-closed
# MESSENGER_ALLOWED_PSIDS=psid1,psid2
# MESSENGER_ACTOR_MAP=psid1:jonatan,psid2:oscar
# Optional explicit flag (also implied when AZOM_USE_MOCK=0):
# MESSENGER_FAIL_CLOSED=1
# Public HTTPS dashboard URL for deep links (no trailing slash)
# AZOM_DASHBOARD_PUBLIC_URL=https://agent.azom.se

# Opt-in live integration smoke (Woo/mail/Telegram). Safe with AZOM_USE_MOCK=1.
# AZOM_LIVE_SMOKE=1
# Poll freshness for /health readiness (seconds; default 900)
# AZOM_POLL_STALE_SEC=900
# Cases Path B: force auto-send off even if config/cases_ai.yaml enables it
# AZOM_AUTO_SEND_KILL=1
# Null-send / Shadow Live Ledger (default off). When 1: refuse customer mail;
# poll records FU9 shadow decisions. Soft-soak: bin/mock-soak-azom.sh.
# Live soft-soak: Oscar sets AZOM_NULL_SEND=1 in .env + restarts poll/dashboard.
# See docs/CASES.md and docs/PILOT_OPS.md. Do NOT default-on in systemd.
# AZOM_NULL_SEND=0

# ---------------------------------------------------------------------------
# Google Ads + GA4 (see docs/MARKETING_GOOGLE.md)
# Fail-closed in live: empty property/customer allowlists deny.
# Mutate kill-switches (default deny when set):
# AZOM_ADS_MUTATE_KILL=1
# AZOM_GA_MUTATE_KILL=1
# AZOM_MP_KILL=1
# ---------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/oauth/google/callback
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# AZOM_GA4_PROPERTY_IDS=123456789
# AZOM_GADS_CUSTOMER_IDS=1234567890
# GOOGLE_MERCHANT_ID=
# GA4_MEASUREMENT_ID=G-XXXX
# GA4_MEASUREMENT_API_SECRET=

# Dashboard auth (Jonatan viewer / Oscar full_admin)
DASHBOARD_USER=jonatan
DASHBOARD_PASSWORD=
# Prefer salted Werkzeug hash (pbkdf2:/scrypt:) — legacy SHA-256 hex still accepted:
# DASHBOARD_PASSWORD_HASH=
# Oscar Basic Auth (username: oscar)
DASHBOARD_OSCAR_PASSWORD=
# DASHBOARD_OSCAR_PASSWORD_HASH=
# Session/CSRF secret (required for POST forms in browser)
# DASHBOARD_SECRET_KEY=

# Runtime
# Local/dev mock: AZOM_USE_MOCK=1
# Production (Ubuntu 24 / Hetzner): AZOM_USE_MOCK=0
# Mock default passwords (jonatan/oscar) ONLY work when AZOM_USE_MOCK=1
AZOM_USE_MOCK=1
AZOM_CONFIG_DIR=./config
AZOM_DATA_DIR=./.azom-data
# Production paths (set by bootstrap-ubuntu24.sh):
# AZOM_CONFIG_DIR=/opt/azom-agent/config
# AZOM_DATA_DIR=/var/lib/azom

# Dashboard bind (systemd uses 127.0.0.1; Docker may use 0.0.0.0)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
